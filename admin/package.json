{
	"name": "pyrobot-admin",
	"private": true,
	"version": "0.4.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "vitest run",
		"gen:api": "openapi-typescript ../openapi.json -o src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.19.0",
		"jsdom": "^30.1.1",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@lucide/svelte": "^1.48.0",
		"openapi-fetch": "^0.17.0",
		"uplot": "^1.6.32"
	}
}
