PYROBOT_DATABASE_URL=postgresql+asyncpg://pyrobot:pyrobot@postgres:5432/pyrobot
PYROBOT_DATA_DIR=/data
# Обязательны при PYROBOT_TRANSPORT=kurigram (my.telegram.org), иначе процесс не стартует
PYROBOT_TG_API_ID=0
PYROBOT_TG_API_HASH=
PYROBOT_ADMIN_LOGIN=admin
PYROBOT_ADMIN_PASSWORD=
PYROBOT_COOKIE_SECURE=true
PYROBOT_TRANSPORT=kurigram
PYROBOT_LOG_LEVEL=INFO
PYROBOT_HTTP_HOST=0.0.0.0
PYROBOT_HTTP_PORT=8080
# Caddy на web: ему uvicorn доверяет X-Forwarded-For (иначе лимитер входа видит один адрес)
PYROBOT_FORWARDED_ALLOW_IPS=10.10.40.3
# Внутренний accounts.id в базе pyrobot, не ID игрока в игре
PYROBOT_ACCOUNT_ID=1
