# Настройки pyrobot для compose.yml: скопируй в .env рядом с compose.yml и заполни.
# Значения со знаками $, # или пробелами — в одинарных кавычках: PYROBOT_ADMIN_PASSWORD='a$b #c'.

# ---------- Обязательно ----------

# Пароль базы Postgres. Только буквы и цифры: из него собирается адрес подключения к базе.
# Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=

# Пароль админки для первого входа (логин — PYROBOT_ADMIN_LOGIN, по умолчанию admin). Нужен при
# первом запуске, когда админа ещё нет: создаёт его. Дальше пароль меняется в админке, а это
# значение больше ни на что не влияет. Сгенерировать: openssl rand -hex 16
PYROBOT_ADMIN_PASSWORD=

# api_id и api_hash приложения Telegram, через которое бот входит в твой аккаунт:
# https://my.telegram.org → API development tools (см. README «Установка»). Без них бот не стартует.
PYROBOT_TG_API_ID=
PYROBOT_TG_API_HASH=

# ---------- По желанию ----------

# Образ бота. Готовый: latest — последняя версия, vX.Y.Z — конкретная (обновление только когда
# сменишь тег сам). Сборка из исходников (git clone + docker compose build) — pyrobot:local.
#PYROBOT_IMAGE=git.fenicu.com/fenicu/pyrobot:latest
#PYROBOT_IMAGE=pyrobot:local

# Адрес и порт админки на этом сервере. По умолчанию 127.0.0.1:8080 — открыта только самому
# серверу: снаружи — через обратный прокси с HTTPS или SSH-туннель.
#PYROBOT_BIND=127.0.0.1
#PYROBOT_PORT=8080

# Cookie входа только по HTTPS (и по http://localhost — например, через SSH-туннель). false — только
# если открываешь админку по http не на localhost: пароль и сессия тогда идут открытым текстом.
#PYROBOT_COOKIE_SECURE=true

# Логин админа для первого входа.
#PYROBOT_ADMIN_LOGIN=admin

# Адреса обратного прокси через запятую, чьему X-Forwarded-For бот верит — по нему ограничивает
# попытки входа. gateway — шлюз сети Docker этого проекта: с него в контейнер приходит прокси на
# этом же сервере (Caddy/nginx на 127.0.0.1:8080), адрес бот узнаёт при старте и пишет в лог
# («trusted proxies: …»). Прокси на другой машине — впиши её адрес вместо gateway; без прокси —
# 127.0.0.1 (не верить никому). Подробнее — README, «Доступ к админке».
#PYROBOT_FORWARDED_ALLOW_IPS=gateway

# Каталог ежесуточных дампов базы (по умолчанию ./backups рядом с compose.yml).
#PYROBOT_BACKUP_DIR=./backups

# Подробность логов: DEBUG, INFO, WARNING, ERROR.
#PYROBOT_LOG_LEVEL=INFO
